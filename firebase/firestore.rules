rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().is_admin == true;
    }

    // Missing fields on old users docs must not deny everyone.
    function accountClosed() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (
          userDoc().get('account_blocked', false) == true
          || userDoc().get('withdrawn_at', false) != false
        );
    }

    function isBusiness() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().is_business == true;
    }

    function ownsShop(shopId) {
      return isBusiness() && userDoc().owned_shop_id == shopId;
    }

    function scoreInRange(value) {
      return value is number && value >= 1 && value <= 5;
    }

    function reviewCommentOk() {
      return !('comment' in request.resource.data)
        || (request.resource.data.comment is string
            && request.resource.data.comment.size() <= 2000);
    }

    function optionalStringIn(field, allowed) {
      return !(field in request.resource.data)
        || (request.resource.data[field] is string
            && request.resource.data[field] in allowed);
    }

    function reviewDetailsOk() {
      return optionalStringIn('diver_level', [
            'open_water', 'advanced', 'rescue_plus', 'instructor', 'freediver'
          ])
        && optionalStringIn('dive_count_band', [
            'dives_under_50', 'dives_50_200', 'dives_200_plus'
          ])
        && optionalStringIn('visibility', [
            'vis_poor', 'vis_ok', 'vis_good', 'vis_excellent'
          ])
        && optionalStringIn('current', [
            'current_mild', 'current_ok', 'current_strong'
          ])
        && optionalStringIn('guide_crowd', [
            'crowd_relaxed', 'crowd_ok', 'crowd_busy'
          ])
        && optionalStringIn('revisit_intent', [
            'revisit_yes', 'revisit_no', 'revisit_unsure'
          ])
        && (!('water_temp_c' in request.resource.data)
            || (request.resource.data.water_temp_c is number
                && request.resource.data.water_temp_c >= -2
                && request.resource.data.water_temp_c <= 40))
        && (!('recommend_for' in request.resource.data)
            || (request.resource.data.recommend_for is list
                && request.resource.data.recommend_for.size() <= 7
                && request.resource.data.recommend_for.hasOnly([
                  'audience_beginner',
                  'audience_experienced',
                  'audience_couple',
                  'audience_family',
                  'audience_photo',
                  'audience_freediver',
                  'audience_tech'
                ])));
    }

    function ownBookingPath(bookingId) {
      return /databases/$(database)/documents/users/$(request.auth.uid)/bookings/$(bookingId);
    }

    function reviewBookingEligible(shopId) {
      return request.resource.data.keys().hasAll(['booking_id'])
        && request.resource.data.booking_id is string
        && request.resource.data.booking_id.size() > 0
        && exists(ownBookingPath(request.resource.data.booking_id))
        && get(ownBookingPath(request.resource.data.booking_id)).data.shop_id == shopId
        && get(ownBookingPath(request.resource.data.booking_id)).data.reviewed != true
        && get(ownBookingPath(request.resource.data.booking_id)).data.status in ['requested', 'confirmed'];
    }

    function validShopReviewCreate(shopId) {
      return isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.shop_id == shopId
        && scoreInRange(request.resource.data.safety)
        && scoreInRange(request.resource.data.guide)
        && scoreInRange(request.resource.data.boat)
        && reviewCommentOk()
        && reviewDetailsOk()
        && reviewBookingEligible(shopId);
    }

    // New-user create must match ensureUserDocument defaults (diver/silver).
    // Privilege escalation on create is denied; update already blocks these keys.
    function userCreatePrivilegeOk() {
      return (!('is_admin' in request.resource.data)
          || request.resource.data.is_admin == false)
        && (!('is_business' in request.resource.data)
          || request.resource.data.is_business == false)
        && !('owned_shop_id' in request.resource.data)
        && (!('user_role' in request.resource.data)
          || request.resource.data.user_role == 'diver')
        && (!('member_grade' in request.resource.data)
          || request.resource.data.member_grade == 'silver')
        && (!('member_grade_locked' in request.resource.data)
          || request.resource.data.member_grade_locked == false)
        && (!('account_blocked' in request.resource.data)
          || request.resource.data.account_blocked == false)
        && !('withdrawn_at' in request.resource.data)
        && !('isAdmin' in request.resource.data)
        && !('isBusiness' in request.resource.data)
        && !('ownedShopId' in request.resource.data);
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && userCreatePrivilegeOk();
      allow update: if isAdmin() || (
        isOwner(userId)
        && !accountClosed()
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['is_admin', 'is_business', 'member_grade', 'user_role', 'owned_shop_id', 'account_blocked', 'withdrawn_at'])
      );
      allow delete: if isAdmin() || (isOwner(userId) && !accountClosed());

      match /logs/{logId} {
        allow get, list: if isOwner(userId) || isAdmin();
        allow create, update, delete: if isAdmin() || (isOwner(userId) && !accountClosed());
      }

      match /bookings/{bookingId} {
        allow get, list: if isOwner(userId) || isAdmin();
        allow create, update, delete: if isAdmin() || (isOwner(userId) && !accountClosed());
      }

      match /reviews/{reviewId} {
        allow get, list: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId)
          && !accountClosed()
          && request.resource.data.uid == request.auth.uid
          && scoreInRange(request.resource.data.safety)
          && scoreInRange(request.resource.data.guide)
          && scoreInRange(request.resource.data.boat)
          && reviewCommentOk()
          && reviewDetailsOk()
          && request.resource.data.keys().hasAll(['booking_id'])
          && request.resource.data.booking_id is string
          && request.resource.data.booking_id.size() > 0;
        allow update: if isOwner(userId)
          && !accountClosed()
          && resource.data.uid == request.auth.uid
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.shop_id == resource.data.shop_id
          && request.resource.data.booking_id == resource.data.booking_id
          && (!('product_id' in resource.data)
              || request.resource.data.product_id == resource.data.product_id)
          && (!('option_id' in resource.data)
              || request.resource.data.option_id == resource.data.option_id)
          && (!('created_at' in resource.data)
              || request.resource.data.created_at == resource.data.created_at)
          && (!('log_id' in resource.data)
              || request.resource.data.log_id == resource.data.log_id)
          && scoreInRange(request.resource.data.safety)
          && scoreInRange(request.resource.data.guide)
          && scoreInRange(request.resource.data.boat)
          && reviewCommentOk()
          && reviewDetailsOk();
        allow delete: if (isOwner(userId)
            && !accountClosed()
            && resource.data.uid == request.auth.uid)
          || isAdmin();
      }
    }

    function diveStarGradeKeys() {
      return ['dive_star_grade', 'dive_star_reviewed_at', 'dive_star_expires_at'];
    }

    function diveStarGradeFieldsAbsent() {
      return !('dive_star_grade' in request.resource.data)
        && !('dive_star_reviewed_at' in request.resource.data)
        && !('dive_star_expires_at' in request.resource.data);
    }

    function diveStarGradeFieldsUnchanged() {
      return !request.resource.data.diff(resource.data)
        .affectedKeys().hasAny(diveStarGradeKeys());
    }

    function diveStarGradeFieldsValid() {
      return (!('dive_star_grade' in request.resource.data)
          || (request.resource.data.dive_star_grade is int
              && request.resource.data.dive_star_grade >= 0
              && request.resource.data.dive_star_grade <= 3))
        && (!('dive_star_reviewed_at' in request.resource.data)
            || request.resource.data.dive_star_reviewed_at is timestamp)
        && (!('dive_star_expires_at' in request.resource.data)
            || request.resource.data.dive_star_expires_at is timestamp);
    }

    match /shops/{shopId} {
      allow read: if true;
      // Grade fields: admin only. Other shop fields (avg_*, products, plaque…):
      // signed-in users may update when grade keys are unchanged (review path).
      allow create: if isSignedIn()
        && diveStarGradeFieldsValid()
        && (isAdmin() || diveStarGradeFieldsAbsent());
      allow update: if isSignedIn()
        && diveStarGradeFieldsValid()
        && (isAdmin() || diveStarGradeFieldsUnchanged());
      // H9: admin trial-data cleanup may remove shops.
      allow delete: if isAdmin();

      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if validShopReviewCreate(shopId);
        allow update: if isSignedIn()
          && resource.data.uid == request.auth.uid
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.shop_id == shopId
          && request.resource.data.shop_id == resource.data.shop_id
          && request.resource.data.booking_id == resource.data.booking_id
          && (!('product_id' in resource.data)
              || request.resource.data.product_id == resource.data.product_id)
          && (!('option_id' in resource.data)
              || request.resource.data.option_id == resource.data.option_id)
          && (!('created_at' in resource.data)
              || request.resource.data.created_at == resource.data.created_at)
          && (!('log_id' in resource.data)
              || request.resource.data.log_id == resource.data.log_id)
          && scoreInRange(request.resource.data.safety)
          && scoreInRange(request.resource.data.guide)
          && scoreInRange(request.resource.data.boat)
          && reviewCommentOk()
          && reviewDetailsOk();
        allow delete: if isSignedIn()
          && (resource.data.uid == request.auth.uid || isAdmin());
      }

      match /bookings/{bookingId} {
        allow read: if isSignedIn() && (
          isAdmin() ||
          ownsShop(shopId) ||
          resource.data.uid == request.auth.uid ||
          request.resource.data.uid == request.auth.uid
        );
        allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
        allow update: if isAdmin() || ownsShop(shopId) ||
          (isSignedIn() && resource.data.uid == request.auth.uid);
        // H9: admin trial-data cleanup may remove shop bookings.
        allow delete: if isAdmin();
      }

      match /product_changes/{changeId} {
        allow read: if isAdmin();
        allow create: if (isAdmin() || ownsShop(shopId))
          && request.resource.data.keys().hasOnly([
            'product_id', 'option_id', 'field', 'before', 'after',
            'actor_uid', 'created_at'
          ])
          && request.resource.data.product_id is string
          && request.resource.data.product_id.size() > 0
          && request.resource.data.product_id.size() <= 120
          && request.resource.data.option_id is string
          && request.resource.data.option_id.size() <= 120
          && request.resource.data.field in [
            'consumer_price', 'professional_price', 'capacity'
          ]
          && request.resource.data.before is int
          && request.resource.data.after is int
          && request.resource.data.before != request.resource.data.after
          && request.resource.data.actor_uid == request.auth.uid
          && request.resource.data.created_at == request.time;
        allow update: if false;
        allow delete: if isAdmin();
      }

      match /daily_stats/{dayId} {
        allow read: if isAdmin() || ownsShop(shopId);
        allow create: if isSignedIn()
          && dayId.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.keys().hasOnly([
            'visits', 'product_views', 'dwell_seconds'
          ])
          && request.resource.data.visits is int
          && request.resource.data.visits >= 0
          && request.resource.data.visits <= 1
          && request.resource.data.product_views is int
          && request.resource.data.product_views >= 0
          && request.resource.data.product_views <= 1
          && request.resource.data.dwell_seconds == 0;
        allow update: if isSignedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'visits', 'product_views', 'dwell_seconds'
          ])
          && request.resource.data.visits is int
          && request.resource.data.visits >= resource.data.get('visits', 0)
          && request.resource.data.visits <= resource.data.get('visits', 0) + 1
          && request.resource.data.product_views is int
          && request.resource.data.product_views >= resource.data.get('product_views', 0)
          && request.resource.data.product_views <= resource.data.get('product_views', 0) + 1
          && request.resource.data.dwell_seconds is int
          && request.resource.data.dwell_seconds >= resource.data.get('dwell_seconds', 0)
          && request.resource.data.dwell_seconds <= resource.data.get('dwell_seconds', 0) + 1800;
        allow delete: if false;
      }

      // Internal Dive Star audits — admin only; confirmed records are locked.
      match /dive_star_assessments/{assessmentId} {
        allow read: if isAdmin();
        allow create: if isAdmin();
        allow update: if isAdmin() && resource.data.confirmed != true;
        allow delete: if isAdmin() && resource.data.confirmed != true;
      }

      // H6 partner contract vault (additive only — do not alter rules above).
      match /partner_contracts/{docId} {
        allow read: if isAdmin()
          || (ownsShop(shopId) && resource.data.status != 'drafting');

        allow create: if isAdmin()
          && request.resource.data.status == 'drafting'
          && request.resource.data.shop_id == shopId;

        allow update: if
          (
            isAdmin()
            && resource.data.status in ['drafting', 'awaiting_signature']
            && request.resource.data.status in [
              'drafting', 'awaiting_signature', 'voided'
            ]
            && !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['signature'])
          )
          || (
            ownsShop(shopId)
            && resource.data.status == 'awaiting_signature'
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly([
                  'last_viewed_at',
                  'last_viewed_by_uid',
                  'revision_note',
                  'revision_requested_at',
                  'revision_requested_by_uid',
                  'signature',
                  'status',
                  'executed_at',
                  'updated_at'
                ])
            && (
              request.resource.data.status == 'awaiting_signature'
              || (
                request.resource.data.status == 'executed'
                && request.resource.data.keys().hasAll([
                  'signature', 'executed_at'
                ])
                && request.resource.data.signature.keys().hasAll([
                  'signer_uid',
                  'signer_name',
                  'signature_png_base64',
                  'signed_at',
                  'doc_sha256'
                ])
                && request.resource.data.signature.signer_uid
                    == request.auth.uid
                && request.resource.data.signature.doc_sha256
                    == resource.data.file_sha256
                && request.resource.data.signature.signed_at == request.time
                && request.resource.data.executed_at == request.time
              )
            )
          );

        allow delete: if false;

        match /events/{eventId} {
          allow read: if isAdmin() || ownsShop(shopId);
          allow create: if isSignedIn()
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.at == request.time
            && request.resource.data.doc_sha256 is string
            && (
              (isAdmin()
                && request.resource.data.type in [
                  'uploaded', 'sent', 'voided'
                ])
              || (ownsShop(shopId)
                && request.resource.data.type in [
                  'viewed',
                  'revision_requested',
                  'signed',
                  'executed'
                ])
            );
          allow update, delete: if false;
        }
      }

      // H4a contract terms. Admin writes the current values and one
      // revision in the same batch. Partners may read only their shop.
      match /contract_terms/{termId} {
        allow read: if termId == 'current'
          && (isAdmin() || ownsShop(shopId));
        allow create, update: if isAdmin()
          && termId == 'current'
          && request.resource.data.keys().hasOnly([
            'commission_rate_percent',
            'party_discount_percent',
            'season_discount_percent',
            'instructor_foc_pay',
            'instructor_foc_free',
            'valid_from',
            'valid_until',
            'updated_at',
            'updated_by_uid'
          ])
          && request.resource.data.updated_by_uid == request.auth.uid
          && request.resource.data.updated_at == request.time
          && (!('commission_rate_percent' in request.resource.data)
              || (request.resource.data.commission_rate_percent is number
                  && request.resource.data.commission_rate_percent >= 0
                  && request.resource.data.commission_rate_percent <= 100))
          && (!('party_discount_percent' in request.resource.data)
              || (request.resource.data.party_discount_percent is number
                  && request.resource.data.party_discount_percent >= 0
                  && request.resource.data.party_discount_percent <= 100))
          && (!('season_discount_percent' in request.resource.data)
              || (request.resource.data.season_discount_percent is number
                  && request.resource.data.season_discount_percent >= 0
                  && request.resource.data.season_discount_percent <= 100))
          && (!('instructor_foc_pay' in request.resource.data)
              || (request.resource.data.instructor_foc_pay is int
                  && request.resource.data.instructor_foc_pay >= 1
                  && request.resource.data.instructor_foc_pay <= 100))
          && (!('instructor_foc_free' in request.resource.data)
              || (request.resource.data.instructor_foc_free is int
                  && request.resource.data.instructor_foc_free >= 0
                  && request.resource.data.instructor_foc_free <= 100))
          && (!('valid_from' in request.resource.data)
              || request.resource.data.valid_from is timestamp)
          && (!('valid_until' in request.resource.data)
              || request.resource.data.valid_until is timestamp)
          && (!('valid_from' in request.resource.data)
              || !('valid_until' in request.resource.data)
              || request.resource.data.valid_until
                  >= request.resource.data.valid_from);
        allow delete: if false;

        match /revisions/{revId} {
          allow read: if isAdmin();
          allow create: if isAdmin()
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.at == request.time
            && request.resource.data.actor_name is string
            && request.resource.data.actor_name.size() > 0
            && request.resource.data.actor_name.size() <= 80
            && request.resource.data.changes is list
            && request.resource.data.changes.size() > 0
            && request.resource.data.changes.size() <= 8;
          allow update, delete: if false;
        }
      }

      // H4b promotion proposals. Partners create on their own shop only.
      // Admins read per shop. No collection group and no delete.
      match /promotion_proposals/{proposalId} {
        allow read: if isAdmin();
        allow create: if ownsShop(shopId)
          && request.resource.data.keys().hasOnly([
            'shop_id', 'kind', 'starts_on', 'ends_on', 'note',
            'status', 'created_at', 'created_by_uid'
          ])
          && request.resource.data.shop_id == shopId
          && request.resource.data.kind in [
            'early_bird', 'price_off', 'same_boat', 'other'
          ]
          && request.resource.data.starts_on is timestamp
          && request.resource.data.ends_on is timestamp
          && request.resource.data.ends_on >= request.resource.data.starts_on
          && request.resource.data.ends_on
              < request.resource.data.starts_on + duration.value(366, 'd')
          && request.resource.data.note is string
          && request.resource.data.note.size() > 0
          && request.resource.data.note.size() <= 80
          && request.resource.data.status == 'new'
          && request.resource.data.created_at == request.time
          && request.resource.data.created_by_uid == request.auth.uid;
        allow update: if isAdmin()
          && resource.data.status == 'new'
          && request.resource.data.status == 'handled'
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'handled_at', 'handled_by_uid'])
          && request.resource.data.handled_at == request.time
          && request.resource.data.handled_by_uid == request.auth.uid;
        allow delete: if false;
      }
    }

    // M1 partner applications. One document per applicant uid.
    // Does not change users privileges.
    match /partner_applications/{applicationId} {
      allow get: if (isSignedIn() && request.auth.uid == applicationId)
        || isAdmin();
      allow list: if isAdmin();

      allow create: if isSignedIn()
        && !(
          exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('is_admin', false) == true
        )
        && !(
          exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('is_business', false) == true
        )
        && request.auth.uid == applicationId
        && request.resource.data.keys().hasOnly([
          'applicant_uid', 'login_id', 'shop_name', 'contact_name',
          'phone', 'region', 'intro', 'link', 'consent',
          'status', 'created_at'
        ])
        && request.resource.data.applicant_uid == request.auth.uid
        && request.resource.data.login_id is string
        && request.resource.data.login_id.size() > 0
        && request.resource.data.login_id.size() <= 80
        && request.resource.data.shop_name is string
        && request.resource.data.shop_name.size() > 0
        && request.resource.data.shop_name.size() <= 80
        && request.resource.data.contact_name is string
        && request.resource.data.contact_name.size() > 0
        && request.resource.data.contact_name.size() <= 40
        && request.resource.data.phone is string
        && request.resource.data.phone.size() > 0
        && request.resource.data.phone.size() <= 40
        && request.resource.data.region is string
        && request.resource.data.region.size() > 0
        && request.resource.data.region.size() <= 40
        && request.resource.data.intro is string
        && request.resource.data.intro.size() > 0
        && request.resource.data.intro.size() <= 80
        && request.resource.data.link is string
        && request.resource.data.link.size() <= 200
        && request.resource.data.consent == true
        && request.resource.data.status == 'new'
        && request.resource.data.created_at == request.time;

      allow update: if isAdmin()
        && resource.data.status == 'new'
        && request.resource.data.status == 'handled'
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'handled_at', 'handled_by_uid'])
        && request.resource.data.handled_at == request.time
        && request.resource.data.handled_by_uid == request.auth.uid;

      allow delete: if false;
    }

    // Versioned audit forms (gates, areas, thresholds) — admin only.
    match /dive_star_forms/{formId} {
      allow read, write: if isAdmin();
    }

    // Partner-facing documents (metadata). Internal = admin only.
    match /partner_documents/{docId} {
      allow write: if isAdmin();
      allow read: if isAdmin()
        || (isBusiness()
            && resource.data.audience == 'public'
            && resource.data.status == 'approved');
    }

    match /document_shares/{shareId} {
      allow read, write: if isAdmin();
    }

    // Channel/template config: partners may read (recommended channels).
    match /partner_doc_config/{configId} {
      allow write: if isAdmin();
      allow read: if isAdmin() || isBusiness();
    }

    // Dive Star LOI applications + pipeline (no Storage; signature PNG in doc).
    match /dive_star_applications/{appId} {
      allow read: if isAdmin()
        || (isBusiness() && resource.data.partner_uid == request.auth.uid);
      allow create: if isBusiness()
        && request.resource.data.partner_uid == request.auth.uid
        && request.resource.data.shop_id is string
        && request.resource.data.shop_id.size() > 0
        && request.resource.data.company_name is string
        && request.resource.data.contact_name is string
        && request.resource.data.signature_png_base64 is string
        && request.resource.data.signature_png_base64.size() > 0
        && request.resource.data.signature_png_base64.size() < 400000;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /partner_email_outbox/{mailId} {
      allow read, write: if isAdmin();
    }

    function seatEventCreateOk() {
      return request.resource.data.keys().hasOnly([
          'kind', 'seat_id', 'shop_id', 'product_id', 'option_id',
          'region', 'resort', 'departure', 'price', 'party_size',
          'member_grade', 'user_key', 'at', 'nationality', 'close_reason'
        ])
        && request.resource.data.kind in [
          'open', 'view', 'flag', 'expire', 'pay', 'cancel', 'close'
        ]
        && request.resource.data.seat_id is string
        && request.resource.data.seat_id.size() > 0
        && request.resource.data.seat_id.size() <= 200
        && request.resource.data.shop_id is string
        && request.resource.data.shop_id.size() <= 120
        && request.resource.data.product_id is string
        && request.resource.data.product_id.size() > 0
        && request.resource.data.product_id.size() <= 120
        && request.resource.data.option_id is string
        && request.resource.data.option_id.size() <= 120
        && request.resource.data.region is string
        && request.resource.data.region.size() <= 80
        && request.resource.data.resort is string
        && request.resource.data.resort.size() <= 120
        && request.resource.data.departure is string
        && (
          request.resource.data.departure == ''
          || request.resource.data.departure.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        )
        && request.resource.data.price is int
        && request.resource.data.price >= 0
        && request.resource.data.party_size is int
        && request.resource.data.party_size >= 0
        && request.resource.data.member_grade in [
          '', 'silver', 'gold', 'diamond', 'platinum'
        ]
        && request.resource.data.user_key is string
        && request.resource.data.user_key.matches('^[0-9a-f]{64}$')
        && request.resource.data.at is timestamp
        && request.resource.data.at > request.time - duration.value(5, 'm')
        && request.resource.data.at < request.time + duration.value(2, 'm')
        && (
          !request.resource.data.keys().hasAny(['nationality'])
          || (
            request.resource.data.nationality is string
            && request.resource.data.nationality.size() >= 2
            && request.resource.data.nationality.size() <= 8
          )
        )
        && (
          !request.resource.data.keys().hasAny(['close_reason'])
          || request.resource.data.close_reason in ['sold_out', 'departed']
        );
    }

    function seatDayCreateOk() {
      return request.resource.data.keys().hasOnly([
          'opens', 'views', 'flags', 'expires', 'pays', 'cancels', 'closes'
        ])
        && request.resource.data.opens is int
        && request.resource.data.opens >= 0
        && request.resource.data.opens <= 1
        && request.resource.data.views is int
        && request.resource.data.views >= 0
        && request.resource.data.views <= 1
        && request.resource.data.flags is int
        && request.resource.data.flags >= 0
        && request.resource.data.flags <= 1
        && request.resource.data.expires is int
        && request.resource.data.expires >= 0
        && request.resource.data.expires <= 1
        && request.resource.data.pays is int
        && request.resource.data.pays >= 0
        && request.resource.data.pays <= 1
        && request.resource.data.cancels is int
        && request.resource.data.cancels >= 0
        && request.resource.data.cancels <= 1
        && request.resource.data.closes is int
        && request.resource.data.closes >= 0
        && request.resource.data.closes <= 1
        && request.resource.data.opens
          + request.resource.data.views
          + request.resource.data.flags
          + request.resource.data.expires
          + request.resource.data.pays
          + request.resource.data.cancels
          + request.resource.data.closes == 1;
    }

    function seatDayPlus(field) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([field])
        && request.resource.data[field] == resource.data[field] + 1;
    }

    function seatOutcomeOk() {
      return request.resource.data.keys().hasOnly([
          'seat_id', 'shop_id', 'opened_on', 'first_flag_minutes',
          'close_minutes', 'fill_rate', 'pay_rate', 'expire_count',
          'close_reason'
        ])
        && request.resource.data.seat_id is string
        && request.resource.data.shop_id is string
        && request.resource.data.opened_on is string
        && request.resource.data.first_flag_minutes is int
        && request.resource.data.close_minutes is int
        && request.resource.data.fill_rate is int
        && request.resource.data.fill_rate >= 0
        && request.resource.data.fill_rate <= 100
        && request.resource.data.pay_rate is int
        && request.resource.data.pay_rate >= 0
        && request.resource.data.pay_rate <= 100
        && request.resource.data.expire_count is int
        && request.resource.data.expire_count >= 0
        && (
          request.resource.data.close_reason == ''
          || request.resource.data.close_reason == 'sold_out'
          || request.resource.data.close_reason == 'departed'
        );
    }

    // Same-boat analytics. Customers create an event or add 1 to a day counter.
    // Admins read every seat from these top-level collections.
    match /seat_events/{eventId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && seatEventCreateOk();
      allow update, delete: if false;
    }

    match /seat_daily/{dayId} {
      allow read: if isAdmin();
      allow create: if isSignedIn()
        && dayId.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && seatDayCreateOk();
      allow update: if isSignedIn() && (
        seatDayPlus('opens')
        || seatDayPlus('views')
        || seatDayPlus('flags')
        || seatDayPlus('expires')
        || seatDayPlus('pays')
        || seatDayPlus('cancels')
        || seatDayPlus('closes')
      );
      allow delete: if false;
    }

    match /seat_outcomes/{seatId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && seatOutcomeOk();
      allow delete: if false;
    }

    match /posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin()
        || (isSignedIn() && resource.data.author_uid == request.auth.uid);

      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.resource.data.author_uid == request.auth.uid;
        allow update, delete: if isAdmin()
          || resource.data.author_uid == request.auth.uid;
      }
    }
  }
}
